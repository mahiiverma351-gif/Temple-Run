
const canvas = document.getElementById("gameCanvas");
const ctx = canvas.getContext("2d");

const scoreEl = document.getElementById("score");
const coinsEl = document.getElementById("coins");
const overlay = document.getElementById("overlay");
const startBtn = document.getElementById("startBtn");

const W = canvas.width;
const H = canvas.height;

let running = false;
let gameOver = false;
let score = 0;
let coins = 0;
let speed = 4;
let lastTime = 0;
let spawnTimer = 0;
let coinTimer = 0;
let elapsed = 0;
let objects = [];
let particles = [];

const player = {
  lane: 1,
  x: W / 2,
  jump: 0,
  jumpVelocity: 0,
  sliding: 0
};

const laneX = [W * 0.32, W * 0.5, W * 0.68];

function resetGame() {
  score = 0;
  coins = 0;
  speed = 4;
  elapsed = 0;
  spawnTimer = 0;
  coinTimer = 0;
  objects = [];
  particles = [];
  player.lane = 1;
  player.x = laneX[1];
  player.jump = 0;
  player.jumpVelocity = 0;
  player.sliding = 0;
  gameOver = false;
  running = true;
  overlay.classList.add("hidden");
  scoreEl.textContent = "0";
  coinsEl.textContent = "0";
  lastTime = performance.now();
  requestAnimationFrame(loop);
}

function move(direction) {
  if (!running) return;
  player.lane = Math.max(0, Math.min(2, player.lane + direction));
}

function jump() {
  if (!running || player.jump > 0 || player.sliding > 0) return;
  player.jumpVelocity = 12;
}

function slide() {
  if (!running || player.jump > 0) return;
  player.sliding = 35;
}

document.addEventListener("keydown", event => {
  if (["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown", " "].includes(event.key)) {
    event.preventDefault();
  }

  if (event.repeat) return;

  if (event.key === "ArrowLeft" || event.key.toLowerCase() === "a") move(-1);
  if (event.key === "ArrowRight" || event.key.toLowerCase() === "d") move(1);
  if (event.key === "ArrowUp" || event.key === " ") jump();
  if (event.key === "ArrowDown" || event.key.toLowerCase() === "s") slide();

  if (event.key === "Enter" && !running) resetGame();
});

document.querySelectorAll("[data-action]").forEach(button => {
  button.addEventListener("pointerdown", event => {
    event.preventDefault();

    const action = button.dataset.action;
    if (action === "left") move(-1);
    if (action === "right") move(1);
    if (action === "jump") jump();
    if (action === "slide") slide();
  });
});

// Background perspective and scenery
function drawBackground() {
  const sky = ctx.createLinearGradient(0, 0, 0, H);
  sky.addColorStop(0, "#75b8a1");
  sky.addColorStop(0.43, "#b8c777");
  sky.addColorStop(1, "#355c2b");

  ctx.fillStyle = sky;
  ctx.fillRect(0, 0, W, H);

  // Distant mountains
  ctx.fillStyle = "#66895a";
  ctx.beginPath();
  ctx.moveTo(0, 220);
  ctx.lineTo(115, 80);
  ctx.lineTo(220, 220);
  ctx.lineTo(355, 95);
  ctx.lineTo(510, 220);
  ctx.lineTo(675, 100);
  ctx.lineTo(800, 220);
  ctx.lineTo(800, H);
  ctx.lineTo(0, H);
  ctx.fill();

  // Jungle sides
  ctx.fillStyle = "#19442b";
  ctx.fillRect(0, 190, W * 0.19, H);
  ctx.fillRect(W * 0.81, 190, W * 0.19, H);

  // Trees
  for (let i = 0; i < 12; i++) {
    const y = (i * 67 + elapsed * speed * 5) % 550;
    const scale = 0.4 + y / 600;
    drawTree(25 + (i % 3) * 45, y, scale);
    drawTree(650 + (i % 4) * 40, y + 20, scale);
  }

  // Running track
  ctx.fillStyle = "#b89965";
  ctx.beginPath();
  ctx.moveTo(W * 0.43, 170);
  ctx.lineTo(W * 0.57, 170);
  ctx.lineTo(W * 0.86, H);
  ctx.lineTo(W * 0.14, H);
  ctx.closePath();
  ctx.fill();

  // Track edges
  ctx.strokeStyle = "#ead5a2";
  ctx.lineWidth = 5;
  ctx.beginPath();
  ctx.moveTo(W * 0.43, 170);
  ctx.lineTo(W * 0.14, H);
  ctx.moveTo(W * 0.57, 170);
  ctx.lineTo(W * 0.86, H);
  ctx.stroke();

  // Perspective lane markings
  ctx.strokeStyle = "#e7d1a0aa";
  ctx.lineWidth = 3;
  ctx.beginPath();
  ctx.moveTo(W * 0.48, 170);
  ctx.lineTo(W * 0.38, H);
  ctx.moveTo(W * 0.52, 170);
  ctx.lineTo(W * 0.62, H);
  ctx.stroke();
}

function drawTree(x, y, scale) {
  if (y < 120 || y > H + 20) return;

  ctx.fillStyle = "#65482b";
  ctx.fillRect(x - 5 * scale, y, 10 * scale, 30 * scale);

  ctx.fillStyle = "#23613b";
  ctx.beginPath();
  ctx.arc(x, y, 18 * scale, 0, Math.PI * 2);
  ctx.arc(x - 10 * scale, y + 10 * scale, 13 * scale, 0, Math.PI * 2);
  ctx.arc(x + 10 * scale, y + 10 * scale, 13 * scale, 0, Math.PI * 2);
  ctx.fill();
}

function spawnObject(type) {
  const lane = Math.floor(Math.random() * 3);

  objects.push({
    type,
    lane,
    y: 155,
    collected: false
  });
}

function update(dt) {
  elapsed += dt;
  speed = Math.min(11, 4 + elapsed * 0.035);
  score += dt * 10;

  player.x += (laneX[player.lane] - player.x) * Math.min(1, dt * 0.018);

  if (player.jumpVelocity !== 0 || player.jump > 0) {
    player.jump += player.jumpVelocity * dt * 0.06;
    player.jumpVelocity -= 0.55 * dt * 0.06;

    if (player.jump <= 0) {
      player.jump = 0;
      player.jumpVelocity = 0;
    }
  }

  if (player.sliding > 0) {
    player.sliding -= dt * 0.06;
  }

  spawnTimer += dt;
  coinTimer += dt;

  if (spawnTimer > Math.max(400, 1100 - speed * 55)) {
    spawnObject(Math.random() < 0.55 ? "rock" : "barrier");
    spawnTimer = 0;
  }

  if (coinTimer > 650) {
    spawnObject("coin");
    coinTimer = 0;
  }

  for (const obj of objects) {
    obj.y += speed * dt * 0.065;

    const close = obj.y > 370 && obj.y < 440;
    const sameLane = obj.lane === player.lane;

    if (close && sameLane && !obj.collected) {
      if (obj.type === "coin") {
        obj.collected = true;
        coins++;
        score += 25;
        makeParticles(laneX[obj.lane], obj.y, "#ffd84d");
      } else if (obj.y > 390 && obj.y < 425) {
        if (obj.type === "rock" && player.jump > 35) continue;
        if (obj.type === "barrier" && player.sliding > 0) continue;
        endGame();
        return;
      }
    }
  }

  objects = objects.filter(obj => obj.y < H + 50 && !obj.collected);

  for (const p of particles) {
    p.x += p.vx * dt * 0.05;
    p.y += p.vy * dt * 0.05;
    p.life -= dt;
  }

  particles = particles.filter(p => p.life > 0);

  scoreEl.textContent = Math.floor(score);
  coinsEl.textContent = coins;
}

function drawObjects() {
  for (const obj of objects) {
    const x = laneX[obj.lane];
    const scale = 0.45 + (obj.y / H) * 0.9;

    ctx.save();
    ctx.translate(x, obj.y);
    ctx.scale(scale, scale);

    if (obj.type === "coin") {
      ctx.fillStyle = "#d99817";
      ctx.beginPath();
      ctx.ellipse(0, 0, 12, 17, 0, 0, Math.PI * 2);
      ctx.fill();

      ctx.strokeStyle = "#fff0a0";
      ctx.lineWidth = 4;
      ctx.beginPath();
      ctx.ellipse(0, 0, 7, 12, 0, 0, Math.PI * 2);
      ctx.stroke();

      ctx.fillStyle = "#fff0a0";
      ctx.font = "bold 15px Arial";
      ctx.textAlign = "center";
      ctx.fillText("$", 0, 5);
    } else if (obj.type === "rock") {
      ctx.fillStyle = "#716a57";
      ctx.beginPath();
      ctx.moveTo(-23, 15);
      ctx.lineTo(-18, -12);
      ctx.lineTo(-4, -24);
      ctx.lineTo(17, -15);
      ctx.lineTo(24, 15);
      ctx.closePath();
      ctx.fill();

      ctx.fillStyle = "#a29a81";
      ctx.beginPath();
      ctx.moveTo(-12, -8);
      ctx.lineTo(-4, -19);
      ctx.lineTo(5, -10);
      ctx.closePath();
      ctx.fill();
    } else {
      ctx.fillStyle = "#764525";
      ctx.fillRect(-26, -10, 52, 24);
      ctx.fillStyle = "#c78b48";
      ctx.fillRect(-26, -10, 52, 6);
      ctx.fillStyle = "#4b311f";
      ctx.fillRect(-21, 14, 8, 8);
      ctx.fillRect(13, 14, 8, 8);
    }

    ctx.restore();
  }
}

function drawPlayer() {
  const x = player.x;
  const y = 420 - player.jump;
  const sliding = player.sliding > 0;

  ctx.save();
  ctx.translate(x, y);

  // Shadow
  ctx.fillStyle = "#26331b66";
  ctx.beginPath();
  ctx.ellipse(0, 8 + player.jump * 0.4, sliding ? 30 : 19, 7, 0, 0, Math.PI * 2);
  ctx.fill();

  if (sliding) {
    // Sliding body
    ctx.fillStyle = "#e8a16d";
    ctx.beginPath();
    ctx.arc(19, -12, 10, 0, Math.PI * 2);
    ctx.fill();

    ctx.fillStyle = "#d84d36";
    ctx.fillRect(-20, -15, 37, 15);

    ctx.strokeStyle = "#263e9b";
    ctx.lineWidth = 8;
    ctx.beginPath();
    ctx.moveTo(-14, -3);
    ctx.lineTo(-32, 3);
    ctx.moveTo(0, -2);
    ctx.lineTo(18, 4);
    ctx.stroke();
  } else {
    // Legs
    const run = running ? Math.sin(elapsed * 0.018) * 9 : 0;
    ctx.strokeStyle = "#263e9b";
    ctx.lineWidth = 9;
    ctx.lineCap = "round";
    ctx.beginPath();
    ctx.moveTo(-6, 12);
    ctx.lineTo(-10 + run, 29);
    ctx.moveTo(6, 12);
    ctx.lineTo(10 - run, 29);
    ctx.stroke();

    // Body
    ctx.fillStyle = "#d94c35";
    ctx.fillRect(-12, -15, 24, 30);

    // Arms
    ctx.strokeStyle = "#e8a16d";
    ctx.lineWidth = 7;
    ctx.beginPath();
    ctx.moveTo(-10, -9);
    ctx.lineTo(-21 - run * 0.4, 5);
    ctx.moveTo(10, -9);
    ctx.lineTo(21 + run * 0.4, 3);
    ctx.stroke();

    // Head
    ctx.fillStyle = "#e8a16d";
    ctx.beginPath();
    ctx.arc(0, -27, 12, 0, Math.PI * 2);
    ctx.fill();

    // Hair
    ctx.fillStyle = "#38271e";
    ctx.beginPath();
    ctx.arc(0, -31, 12, Math.PI, Math.PI * 2);
    ctx.fill();

    // Eyes
    ctx.fillStyle = "#222";
    ctx.fillRect(-5, -28, 3, 3);
    ctx.fillRect(3, -28, 3, 3);
  }

  ctx.restore();
}

function makeParticles(x, y, color) {
  for (let i = 0; i < 9; i++) {
    particles.push({
      x, y,
      vx: (Math.random() - 0.5) * 5,
      vy: (Math.random() - 0.5) * 5,
      life: 450,
      color
    });
  }
}

function drawParticles() {
  for (const p of particles) {
    ctx.globalAlpha = Math.max(0, p.life / 450);
    ctx.fillStyle = p.color;
    ctx.beginPath();
    ctx.arc(p.x, p.y, 4, 0, Math.PI * 2);
    ctx.fill();
  }
  ctx.globalAlpha = 1;
}

function draw() {
  drawBackground();
  drawObjects();
  drawPlayer();
  drawParticles();

  // Small in-game speed display
  ctx.fillStyle = "#102b1b";
  ctx.fillRect(12, 12, 110, 31);
  ctx.fillStyle = "#ffffff";
  ctx.font = "bold 13px Arial";
  ctx.textAlign = "left";
  ctx.fillText("SPEED " + speed.toFixed(1), 22, 32);
}

function loop(now) {
  if (!running) return;

  const dt = Math.min(now - lastTime, 40);
  lastTime = now;

  update(dt);
  draw();

  if (running) requestAnimationFrame(loop);
}

function endGame() {
  running = false;
  gameOver = true;

  document.getElementById("panelIcon").textContent = "💥";
  document.getElementById("panelTitle").textContent = "Game Over!";
  document.getElementById("panelText").textContent =
    `Your score: ${Math.floor(score)} | Coins collected: ${coins}`;

  startBtn.textContent = "🔄 Play Again";
  overlay.classList.remove("hidden");
}

startBtn.addEventListener("click", () => {
  document.getElementById("panelIcon").textContent = "🏃";
  document.getElementById("panelTitle").textContent = "Jungle Escape";
  startBtn.textContent = "▶ Start Running";
  resetGame();
});

// Draw the opening screen before the game starts.
draw();
